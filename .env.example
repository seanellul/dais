# Dais environment variables. Copy to .env.local for local development.
# Every variable is optional for `pnpm dev`: with no DATABASE_URL, Dais runs on an
# embedded PGlite database stored in ./data/pglite (gitignored).

# Postgres connection string. On Vercel + Neon this MUST be the pooled endpoint
# (host contains "-pooler"); Neon's direct endpoint exhausts the free-plan
# connection budget under a burst of judge submissions.
# TLS follows the URL's sslmode: `require` and `verify-full` both mean verified
# TLS (verify-full avoids a one-time deprecation warning from pg); a Postgres
# without TLS (Docker Compose, a LAN box, CI) needs `sslmode=disable`.
# DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/dais?sslmode=require

# Directory for the embedded PGlite database when DATABASE_URL is unset.
# PGLITE_DIR=./data/pglite

# 32+ random bytes, base64. Used to sign cookies and pepper session hashes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bearer token that protects /api/cron/* routes (Vercel Cron sends it).
CRON_SECRET=change-me-too

# Public origin, used in QR codes, join links and emails.
APP_URL=http://localhost:3000

# Set to 0 on self-hosted instances that must not expose the public demo.
DEMO_ENABLED=1

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Who applies database migrations when the app opens its database.
# PGlite migrates itself unless this is 0. Postgres migrates itself only when
# this is 1, and never on a Vercel preview; otherwise CI, `pnpm db:migrate` or
# the Docker entrypoint migrates it.
# DB_AUTO_MIGRATE=0

# Build label that /api/health reports as `version`. The Docker image sets it
# from its GIT_SHA build argument; on Vercel the commit SHA is used instead.
# DAIS_VERSION=dev
